# owarin-store = code + docs only (B1, 2026-10-07). Media/data live in C:\Users\JIN\OWARIN-DATA,
# secrets in C:\Users\JIN\Documents\OWARIN-secrets. No trailing "/" on the junctions: git may see a junction as a link.

# media/data folders = junctions to C:\Users\JIN\OWARIN-DATA\<name>
/All Products
/_r2_upload
/GGB Online Files
/_fb_albums
/Supplier
/_exports
/Facebook - Catalouge Project
/_from-outer-root/outputs

# secrets - never commit
.env
.env.*
!.env.example
credential/
*credential*.json
*.key
*.pem
*token*.txt
*secret*.json

