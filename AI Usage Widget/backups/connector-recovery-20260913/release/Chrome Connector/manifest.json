{
  "manifest_version": 3,
  "name": "AI Usage Widget Connector",
  "version": "2.0.0",
  "description": "Reads only Claude Usage and sends quota to the local widget through Chrome Native Messaging.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://claude.ai/settings/usage*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/settings/usage*"
      ],
      "js": [
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI Usage Widget: connection status",
    "default_popup": "popup.html"
  }
}
